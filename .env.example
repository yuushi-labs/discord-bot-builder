# ========================================
# Discord Bot Builder - Environment Variables
# ========================================
# このファイルをコピーして .env を作成し、
# 以下の値を自分の環境に合わせて設定してください

# ========================================
# Database Configuration
# ========================================
# MySQL データベース接続文字列
# 形式: mysql://username:password@host:port/database
#
# ここに書いたユーザー名・パスワードは MySQL 側と完全に一致している必要があります。
# ユーザーが未作成の場合は `pnpm run db:setup` で作成できます（詳細: SETUP_GUIDE.md）。
# テーブルはサーバー初回起動時に自動作成されます（`pnpm run db:push` でも作成可）。
DATABASE_URL=mysql://bot_user:secure_password@localhost:3306/discord_bot_builder

# スキーマを別の場所で管理する場合（複数インスタンスの同時起動やデプロイ手順で
# マイグレーションを実行する場合）は false にすると起動時の自動マイグレーションを
# 無効化できます。
# DB_AUTO_MIGRATE=false

# ========================================
# Discord OAuth Configuration
# ========================================
# Discord Developer Portal から取得
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# ========================================
# Frontend Discord OAuth Configuration
# ========================================
# フロントエンドで使用する Discord Client ID
# （DISCORD_CLIENT_ID と同じ値）
VITE_DISCORD_CLIENT_ID=your_discord_client_id_here

# ========================================
# JWT Configuration
# ========================================
# JWT トークン署名用の秘密鍵
# 安全なランダム文字列を生成してください
# 例: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_change_this_in_production

# Token encryption: generate once with openssl rand -base64 32 and keep it safe.
# Changing or losing this key makes stored tokens unreadable.
TOKEN_ENCRYPTION_KEY=

# ========================================
# Server Configuration
# ========================================
# サーバーのポート番号
PORT=3000

# Node 環境
NODE_ENV=development

# ========================================
# OAuth Callback URLs
# ========================================
# 開発環境
OAUTH_CALLBACK_URL=http://localhost:3000/api/discord/callback

# 本番環境の場合は以下のようにしてください
# OAUTH_CALLBACK_URL=https://yourdomain.com/api/discord/callback

# ========================================
# Frontend URLs
# ========================================
# フロントエンドの URL
VITE_APP_URL=http://localhost:3000

# ========================================
# Logging
# ========================================
# ログレベル: debug, info, warn, error
LOG_LEVEL=info
